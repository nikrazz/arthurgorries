{
  "name": "arthurgorries",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-28",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arthurgorries-db",
      "database_id": "691be321-21b6-465f-804b-dd3db14b06e9"
    }
  ]
}
